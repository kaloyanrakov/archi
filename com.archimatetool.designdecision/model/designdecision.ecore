<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="model"
    nsURI="http://www.archimatetool.com/archimate/designdecision"
    nsPrefix="designdecision">

  <eClassifiers xsi:type="ecore:EEnum" name="DesignDecisionType">
    <eLiterals name="Structural" value="0" literal="Structural"/>
    <eLiterals name="Behavioral" value="1" literal="Behavioral"/>
    <eLiterals name="Property" value="2" literal="Property"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="DesignDecision"
      eSuperTypes="../../com.archimatetool.model/model/archimate.ecore#//MotivationElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="decisionType"
        eType="#//DesignDecisionType"
        defaultValueLiteral="Structural"/>
  </eClassifiers>

</ecore:EPackage>