Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %pluginName
Bundle-SymbolicName: com.archimatetool.designdecision;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: %providerName
Bundle-Localization: plugin
Bundle-RequiredExecutionEnvironment: JavaSE-21
Eclipse-BundleShape: dir
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.emf.ecore;visibility:=reexport,
 org.eclipse.emf.ecore.xmi;visibility:=reexport,
 com.archimatetool.model;visibility:=reexport,
 com.archimatetool.editor
Bundle-ClassPath: com.archimatetool.designdecision.jar
Bundle-Activator: com.archimatetool.designdecision.DesignDecisionPlugin
Bundle-ActivationPolicy: lazy
Export-Package: com.archimatetool.designdecision,
 com.archimatetool.designdecision.factory,
 com.archimatetool.designdecision.figures,
 com.archimatetool.designdecision.model,
 com.archimatetool.designdecision.model.impl,
 com.archimatetool.designdecision.model.util
Automatic-Module-Name: com.archimatetool.designdecision
