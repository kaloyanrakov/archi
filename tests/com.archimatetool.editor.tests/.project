<?xml version="1.0" encoding="UTF-8"?>
<projectDescription>
  <name>com.archimatetool.editor.tests</name>
  <comment>NO_M2ECLIPSE_SUPPORT: Project files created with the maven-eclipse-plugin are not supported in M2Eclipse.</comment>
  <projects>
    <project>com.archimatetool.testsupport</project>
    <project>com.archimatetool.editor</project>
    <project>org.eclipse.gef</project>
    <project>org.eclipse.draw2d</project>
    <project>com.archimatetool.jdom</project>
    <project>com.archimatetool.model</project>
    <project>com.archimatetool.widgets</project>
  </projects>
  <buildSpec>
    <buildCommand>
      <name>org.eclipse.jdt.core.javabuilder</name>
    </buildCommand>
    <buildCommand>
      <name>org.eclipse.pde.ManifestBuilder</name>
    </buildCommand>
    <buildCommand>
      <name>org.eclipse.pde.SchemaBuilder</name>
    </buildCommand>
  </buildSpec>
  <natures>
    <nature>org.eclipse.pde.PluginNature</nature>
    <nature>org.eclipse.jdt.core.javanature</nature>
  </natures>
</projectDescription>